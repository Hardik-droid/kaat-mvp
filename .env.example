# Obtain this from app.gnani.ai. DO NOT COMMIT REAL KEYS.
GNANI_API_KEY=

# Push-to-talk maximum in seconds: finite 0.5-25; defaults to 6.
# A locally saved "Listen up to" preference takes precedence in the desktop UI.
# KAAT_CAPTURE_SECONDS=6

# Optional reasoning provider, disabled unless URL/model are configured.
# Full OpenAI-compatible chat-completions endpoint: HTTPS, or HTTP on localhost.
# Only proposes reviewed steps; it never executes a complex workflow.
# Key may be blank for a local provider. Never commit real credentials.
# KAAT_PLANNER_URL=
# KAAT_PLANNER_MODEL=
# KAAT_PLANNER_KEY=

# Optional local memory directory; defaults to %USERPROFILE%\.kaat
# KAAT_DATA_DIR=C:\Users\you\.kaat

# Optional explicit executables; otherwise PATH and project .tools are searched.
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BINARY=C:\ffmpeg\bin\ffprobe.exe

# Opt-in real provider integration test: explicitly chosen <=30s human Hinglish WAV.
# This file-based check is separate from live microphone acceptance.
# KAAT_TEST_AUDIO=C:\Users\you\Videos\hinglish-command.wav
